# base sepolia rpc
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# operator role who needs base sepolia eth for gas
OWNER_PRIVATE_KEY=0x

# agent private key and address, which needs eth for gas (pay() calls) and does NOT hold USDC
AGENT_PRIVATE_KEY=0x
AGENT_ADDRESS=0x

# service provider which receives usdc
PAYEE_ADDRESS=0x

# ---- policy (6-decimal USDC units; 1_000000 = $1) -------------------------

PER_CALL_MAX=1000000
DAILY_MAX=12000000
VAULT_FUNDING=1000000000

# ---- written by the deploy script (R3) -----------------------------------

USDC_ADDRESS=
VAULT_ADDRESS=
